# Environment Configuration
# Copy this file to .env and fill in your actual values.
# NEVER commit the real .env file.

# LLM Configuration
LLM_API_KEY="your_api_key_here"
LLM_MODEL="gpt-4o-mini" # or another preferred model

# Database Configuration (for future PostgreSQL/PostGIS integration)
DATABASE_URL="postgresql://user:password@localhost:5432/cybercrime_db"

# ML Service Configuration
ML_SERVICE_URL="http://localhost:8000"

# Application Settings
LOG_LEVEL="INFO"
MAX_ITERATIONS=10
MAX_TOOL_CALLS=20
MAX_GRAPH_DEPTH=15
MAX_ACCOUNTS_INVESTIGATED=10
MAX_EXECUTION_TIME=300
